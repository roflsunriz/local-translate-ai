{
  "name": "local-translate-ai",
  "version": "1.8.0",
  "description": "Firefox extension for translation using local LLM (llama.cpp)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.8",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --configLoader runner",
    "amo:validate": "node scripts/validate-amo-metadata.mjs",
    "amo:lint": "web-ext lint -s dist",
    "preview": "web-ext run -s dist --firefox=firefox",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "zip:source": "git archive --format=zip --output=source-code.zip HEAD",
    "zip:dist": "web-ext build -s dist -a web-ext-artifacts --overwrite-dest",
    "sign:unlisted": "web-ext sign -s dist --channel \"unlisted\"",
    "sign:listed": "web-ext sign -s dist --channel \"listed\" --amo-metadata \"amo-metadata.json\" --upload-source-code \"source-code.zip\"",
    "amo:unlisted": "bun run build && bun run zip:source && bun run zip:dist && bun run sign:unlisted",
    "amo:listed": "bun run build && bun run zip:source && bun run zip:dist && bun run sign:listed"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "dompurify": "^3.4.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "web-ext": "^9.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roflsunriz/local-translate-ai"
  },
  "keywords": [
    "firefox-extension",
    "translation",
    "llama-cpp",
    "plamo",
    "local-llm"
  ],
  "overrides": {
    "adm-zip": "0.6.1",
    "fast-uri": "4.1.3",
    "flatted": "3.4.3",
    "image-size": "2.0.3",
    "node-forge": "1.4.0",
    "picomatch": "4.0.5",
    "rollup": "4.62.2",
    "shell-quote": "1.10.0",
    "tmp": "0.2.7",
    "uuid": "14.0.1",
    "yauzl": "3.4.0"
  }
}
